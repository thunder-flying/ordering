page {
  --paper: #f7f3ea;
  --paper-bright: #fffcf5;
  --paper-deep: #eee7da;
  --ink: #1f4d3a;
  --ink-deep: #263b31;
  --ink-muted: #6f756b;
  --cinnabar: #b94b3e;
  --line: #ded3c0;
  min-height: 100%;
  background-color: var(--paper);
  background-image:
    radial-gradient(circle at 12% 8%, rgba(94, 111, 90, 0.045) 0, transparent 24%),
    radial-gradient(circle at 82% 38%, rgba(185, 75, 62, 0.035) 0, transparent 19%);
  color: var(--ink-deep);
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
  font-size: 30rpx;
  line-height: 1.6;
}

view,
scroll-view,
swiper,
button,
input,
textarea,
image {
  box-sizing: border-box;
}

button,
.tap-target {
  min-height: 88rpx;
}

button {
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
}

button[disabled] {
  opacity: 0.68;
}

input,
textarea {
  color: var(--ink-deep);
}

input::placeholder,
textarea::placeholder {
  color: #9a988f;
}

.paper-panel {
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
  background: var(--paper-bright);
  box-shadow: 0 12rpx 34rpx rgba(48, 61, 50, 0.07);
}

.page-enter {
  animation: page-enter 360ms ease-out both;
}

@keyframes page-enter {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
