{
  "name": "@ordering/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "prisma generate",
    "pretest:integration": "prisma generate",
    "pretypecheck": "prisma generate",
    "build": "next build && pnpm build:cli",
    "build:cli": "esbuild src/cli/cleanup-uploads.ts --bundle --platform=node --format=esm --packages=external --alias:server-only=./src/lib/server-only-empty.ts --outfile=dist-cli/cleanup-uploads.mjs",
    "cleanup:uploads": "node dist-cli/cleanup-uploads.mjs",
    "dev": "next dev",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "start": "next start",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@ordering/contracts": "workspace:*",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "file-type": "^21.3.4",
    "jose": "^6.2.9",
    "mariadb": "^3.5.3",
    "next": "^16.0.0",
    "prisma": "^7.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
