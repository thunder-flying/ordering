:host {
  display: block;
}

.dish-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid #dfd5c4;
  border-radius: 8rpx;
  background: #fffcf5;
  box-shadow: 0 10rpx 28rpx rgba(46, 62, 49, 0.06);
}

.dish-card::before {
  position: absolute;
  top: 0;
  left: 26rpx;
  width: 52rpx;
  height: 8rpx;
  background: #b94b3e;
  content: "";
}

.dish-main {
  display: flex;
  gap: 24rpx;
  padding: 28rpx 26rpx 24rpx;
}

.dish-image-wrap {
  width: 184rpx;
  height: 184rpx;
  flex: 0 0 184rpx;
  overflow: hidden;
  border-radius: 4rpx;
  background: #e6e7db;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.dish-image-fallback {
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #526158;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  line-height: 1.5;
}

.dish-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.dish-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.dish-name {
  color: #213d30;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.dish-price {
  flex: 0 0 auto;
  color: #a23f35;
  font-size: 30rpx;
  font-weight: 700;
}

.price-caption {
  align-self: flex-end;
  color: #59645b;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.dish-description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 20rpx;
  color: #526158;
  font-size: 26rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.dish-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 0 26rpx 26rpx;
}

.favorite-button,
.add-button {
  min-width: 176rpx;
  min-height: 88rpx;
  margin: 0;
  border-radius: 4rpx;
  font-size: 26rpx;
  line-height: 88rpx;
}

.favorite-button {
  border: 1rpx solid #728078;
  background: transparent;
  color: #1f4d3a;
}

.favorite-button.is-favorite {
  border-color: #a23f35;
  color: #a23f35;
}

.add-button {
  background: #1f4d3a;
  color: #fffaf0;
}

.favorite-button::after,
.add-button::after {
  border: 0;
}
