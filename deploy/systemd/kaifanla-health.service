[Unit]
Description=Check kaifanla HTTPS, containers, certificate and host exposure
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/kaifanla/deploy
EnvironmentFile=-/etc/kaifanla/production.env
ExecStart=/opt/kaifanla/deploy/scripts/health-check.sh
TimeoutStartSec=2min
