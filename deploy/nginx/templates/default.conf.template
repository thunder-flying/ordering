limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=login_per_ip:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=wechat_auth_per_ip:10m rate=10r/m;
limit_req_status 429;
server_tokens off;

server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name ${APP_DOMAIN};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/acme;
    default_type text/plain;
    try_files $uri =404;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  http2 on;
  server_name ${APP_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:kaifanla_tls:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  client_max_body_size 512k;
  include /etc/nginx/snippets/security-headers.conf;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Request-ID $request_id;
  proxy_set_header Connection "";
  proxy_connect_timeout 5s;
  proxy_send_timeout 15s;
  proxy_read_timeout 15s;
  proxy_hide_header X-Powered-By;

  location = /api/v1/auth/wechat {
    limit_req zone=wechat_auth_per_ip burst=3 nodelay;
    proxy_pass http://server:3000;
  }

  location = /api/v1/admin/session {
    limit_req zone=login_per_ip burst=3 nodelay;
    proxy_pass http://server:3000;
  }

  location = /api/v1/profile/avatar {
    limit_req zone=api_per_ip burst=5 nodelay;
    client_max_body_size 3m;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_pass http://server:3000;
  }

  location = /api/v1/admin/uploads/dish-image {
    limit_req zone=api_per_ip burst=5 nodelay;
    client_max_body_size 6m;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_pass http://server:3000;
  }

  location ^~ /api/v1/ {
    limit_req zone=api_per_ip burst=20 nodelay;
    proxy_pass http://server:3000;
  }

  location ^~ /admin {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
    proxy_pass http://server:3000;
  }

  location ^~ /media/avatars/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "private, no-store" always;
    proxy_pass http://server:3000;
  }

  location ~ "^/media/dishes/[a-f0-9]{64}\.(?:jpg|png|webp)$" {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    proxy_pass http://server:3000;
  }

  location /media/dishes/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
    proxy_pass http://server:3000;
  }

  location / {
    proxy_pass http://server:3000;
  }
}
